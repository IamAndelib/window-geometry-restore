 <class>KWin::WindowGeometryRestoreConfigForm</class>
 <widget class="QWidget" name="KWin::WindowGeometryRestoreConfigForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>560</width>
    <height>420</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QLabel" name="introLabel">
     <property name="text">
      <string>Window Geometry Restore remembers how you left your application windows (position, size, screen and tile) on each virtual desktop and monitor, and puts them back when the app reopens - for apps that don't do it themselves, like Chrome web apps. It works with KWin: windows a KWin window rule places are left to the rule, tiles and maximizing are restored through KWin, and focus and desktops stay KWin's.

Everything works out of the box. The only thing you may ever need to change is the exclusion list below.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="blacklistGroup">
     <property name="title">
      <string>Excluded applications (one per line, * acts as a wildcard)</string>
     </property>
     <layout class="QVBoxLayout" name="blacklistLayout">
      <item>
       <widget class="QPlainTextEdit" name="kcfg_blacklist"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="kcfg_restoreTiles">
     <property name="text">
      <string>Restore tiled windows into their tile</string>
     </property>
     <property name="toolTip">
      <string>A window that was tiled when it closed reopens in the same tile, and dragging it out gives back the size it had before tiling. When off, it reopens floating at the tile's position and size.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="kcfg_debug">
     <property name="text">
      <string>Verbose debug logging</string>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
